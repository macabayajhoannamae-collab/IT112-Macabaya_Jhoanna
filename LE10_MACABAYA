#include<stdio.h>

int main () {
    FILE *file;
    int n, i;
    char note[200];
    char line[200];

    file = fopen("notes.txt", "w");

    if (file == NULL) {
        printf("Error creating file.");
        return 1;
    }

    printf("Writing Notes File:\n");
    printf("How many notes do you want to record? ");
    scanf("%d", &n);
    
    getchar();

    for (i = 1; i <= n; i++) {
        printf("\nNote %d: ", i);
        fgets(note, sizeof(note), stdin);
        fprintf(file, "%s", note);
    }

    fclose(file);
    
    printf("\nInitial notes saved successfully.\n");

    file = fopen("notes.txt", "a");

    if (file == NULL) {
        printf("Error opening file.");
        return 1;
    }

    printf("\nEnter one additional note: \n");
    fgets(note, sizeof(note), stdin);
    fprintf(file, "%s", note);

    fclose(file);

    printf("\nNew note added successfully.\n");

    file = fopen("notes.txt", "r");

    if (file == NULL) {
        printf("Error reading file.");
        return 1;
    }

    printf("\nReading Saved Notes:\n\n");

    i = 1;

    while (fgets(line, sizeof(line), file) != NULL) {
        printf("%d. %s", i, line);
        i++;
    }

    fclose(file);

    return 0;
}
